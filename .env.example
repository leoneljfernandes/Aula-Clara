# Aula Clara · variables de entorno (archivo de referencia, versionado).
# Copiar a .env en la raíz del repo y completar:  cp .env.example .env
# El .env real NUNCA se versiona (está en .gitignore). En Vercel, cada variable se carga en
# Settings → Environment Variables; los archivos .env son solo para desarrollo local.
#
# Lo leen dos piezas:
#   - el backend (backend/app/config.py, Settings): todo lo que no empieza con VITE_
#   - el frontend (Vite, con envDir en la raíz): SOLO las VITE_*, que terminan en el bundle
#     público. Nunca pongas un secreto en una variable VITE_*.

# ─── Backend: aplicación ──────────────────────────────────────────────
# APP_ENV no se escribe acá: elige qué archivo .env se carga, así que va en el entorno real
# (export APP_ENV=prod). Sin ella el stage es dev.
# APP_ENV=dev
ERRORS_BASE_URL=https://errors.aula-clara.invalid  # prefijo del campo "type" de los errores problem+json
CORS_ORIGINS=["http://localhost:5173"]             # JSON. En Pages, sumar https://<usuario>.github.io
DOCS_ENABLED=true                                  # /docs y /openapi.json: solo en desarrollo

# Opcionales (valores por defecto):
# APP_NAME=aula-clara-api
# APP_VERSION=0.1.0
# DEBUG=false
# LOG_LEVEL=INFO

# ─── Backend: inteligencia artificial ─────────────────────────────────
# El servidor NO tiene API keys ni modelo de IA. Cada persona carga su propia key y elige el modelo
# en la app («Configurar IA»); el navegador los manda en cada consulta y el backend no los guarda.
# Proveedores admitidos: Gemini, Groq, OpenRouter, Mistral y NVIDIA Build (todos con uso gratuito).
# Guía para conseguir la key: /ayuda/ia en la app.

# Key sellada (recomendado en producción). Con esta clave, la API key de cada persona viaja en una cookie
# HttpOnly cifrada que el JavaScript de la página no puede leer. Sin ella funciona igual, en modo de headers,
# con la key guardada en el navegador. Es un secreto DEL SERVIDOR (no una key de IA). Para generarla:
#   uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambiás, quienes tengan una key guardada deben cargarla de nuevo; para rotar sin eso, poné la
# anterior en SEALING_KEY_PREVIOUS (se acepta para leer, ya no para sellar).
SEALING_KEY=
# SEALING_KEY_PREVIOUS=
# AI_SESSION_HOURS=12            # vida de la cookie si no se marca «Recordar en este dispositivo»
# AI_SESSION_REMEMBER_DAYS=30    # vida con «Recordar en este dispositivo»

# Protección del servicio (valores por defecto):
# MAX_INPUT_CHARS=12000        # se recorta el texto del documento antes de mandarlo
# MAX_IMAGE_BYTES=4194304      # 4 MB
# RATE_LIMIT_PER_MIN=10        # consultas de IA por minuto y por IP
# AI_CACHE_TTL_SECONDS=3600    # caché en memoria por (key, modelo, acción, texto)
# AI_TIMEOUT_SECONDS=20        # por llamada al proveedor; máximo 25 (entra en los 30 s de Vercel)

# ─── Frontend (Vite) ──────────────────────────────────────────────────
# VITE_API_URL vacía = mismo origen (/api/v1): proxy de Vite en dev, Vercel en prod.
# En GitHub Pages apuntando al backend de Vercel: https://<proyecto>.vercel.app
VITE_API_URL=

# No son de Settings ni van al bundle: los lee vite.config.ts.
# FRONTEND_API_PROXY_TARGET=http://localhost:8000   # proxy del dev server hacia FastAPI
# BASE_PATH=/                                        # en GitHub Pages: /<nombre-del-repo>/
